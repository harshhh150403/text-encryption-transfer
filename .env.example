# Copy this file to .env and adjust it (scripts/setup_test_keys.py does this for you).
# It holds the settings of both pipelines: encryption (files we send to SBI) and decryption (files
# SBI sends us). Each pipeline only uses its own settings, plus GPG_BINARY, timing and logging.
# Relative paths are relative to the project folder. On Windows, write paths without quotes,
# for example: SOURCE_DIR=D:\pipeline\Source
# A setting that is already an environment variable takes precedence over this file.

# ======== Encryption pipeline: files we send to SBI ========

# --- Folders ---
SOURCE_DIR=Source
SINK_DIR=Sink
# Where originals go after encryption. Empty means an "archive" folder inside SOURCE_DIR.
ARCHIVE_DIR=
# Only files whose names match this pattern are picked up (not case-sensitive). Several patterns
# can be given, separated by commas.
FILE_PATTERN=SBI_*.txt

# --- Keys ---
# The encryption pipeline's GnuPG keyring folder. It holds public keys only.
GNUPG_HOME=gnupg_home
# Full fingerprint of the recipient's (SBI's) public key. Several can be given, separated by commas,
# but then anyone holding any one of those keys can decrypt the files.
RECIPIENT_FINGERPRINTS=
# Optional: also sign each file with our own private key. SBI asked for no signature, so leave empty.
SIGNING_KEY_FINGERPRINT=
SIGNING_KEY_PASSPHRASE=
# Keys created by recent GnuPG or Kleopatra (SBI's UAT keys among them) ask gpg to use its newer OCB
# format. GnuPG 2.3+ and Kleopatra decrypt it, but many other PGP programs can't, so the pipeline
# refuses such keys. Only set this to true if the recipient confirms their software decrypts OCB.
ALLOW_GNUPG_ONLY_FORMAT=false

# --- File format: the defaults are what SBI asked for ---
# Encryption algorithm: AES256, AES192 or AES128.
CIPHER_ALGO=AES256
# Compression before encrypting: none, zip, zlib or bzip2.
COMPRESSION=none
# true: the encrypted file is text ("ASCII-armored", starting with -----BEGIN PGP MESSAGE-----).
# false: binary.
ARMOR=true

# ======== Decryption pipeline: files SBI sends us ========
# Run it with: python main.py decrypt

# Encrypted files from SBI arrive here.
DECRYPT_SOURCE_DIR=Inbound
# Decrypted files are written here. They are readable bank data: restrict access to this folder.
DECRYPT_DESTINATION_DIR=Decrypted
# Where the encrypted originals go after decryption. Empty means an "archive" folder inside
# DECRYPT_SOURCE_DIR.
DECRYPT_ARCHIVE_DIR=
# Which files are picked up. The decrypted file is named without the .pgp, .gpg or .asc.
DECRYPT_FILE_PATTERN=*.pgp, *.gpg, *.asc
# The decryption pipeline's keyring folder, which holds OUR private key (create it with
# scripts/create_decryption_key.py). It must differ from GNUPG_HOME.
DECRYPT_GNUPG_HOME=gnupg_home_decrypt
# The passphrase of our private key, written as is after the =, unless create_decryption_key.py
# says to put it in single quotes. Restrict access to this file, and keep a copy of the passphrase
# in IT's password manager, separate from the private key backup.
DECRYPT_KEY_PASSPHRASE=

# ======== Both pipelines ========

# Full path to gpg. Only needed if "gpg --version" doesn't work in a new terminal,
# for example: C:\Program Files (x86)\GnuPG\bin\gpg.exe
GPG_BINARY=

# --- Timing, in seconds ---
# A file is picked up once it hasn't changed for this long.
STABLE_SECONDS=5
# How often each pipeline looks in its source folder.
POLL_SECONDS=2
# How long to wait before retrying a file that failed.
RETRY_SECONDS=300

# --- Logging ---
# Each pipeline writes its own log here: encrypt.log and decrypt.log.
LOG_DIR=logs
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
